# Copy to .env for local development. Never commit populated .env files.
# Generate a private value locally with Django's get_random_secret_key().
SESSION_SECRET=
DEBUG=False
SITE_URL=https://kpn.com.ng
# Set DATABASE_URL privately in production. Omit it entirely for local SQLite.
# DATABASE_URL=sqlite:///db.sqlite3
# Populate all three privately for persistent Cloudinary upload storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Explicit local development email override; configure Lockally on production.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
LOCKALLY_API_KEY=
LOCKALLY_API_URL=
LOCKALLY_FROM_EMAIL=
FIREBASE_CREDENTIALS_FILE=